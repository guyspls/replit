# Copy to .env and fill in only the channels you want. Any one of them is enough.

# --- ntfy: fastest route to a phone. Install the ntfy app, subscribe to this
# --- topic, done. Pick something unguessable: anyone who knows it can read it.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# --- Discord: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# --- Telegram: talk to @BotFather for a token, @userinfobot for your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Slack: an Incoming Webhook URL
SLACK_WEBHOOK_URL=

# --- Email via Resend (resend.com, free tier)
RESEND_API_KEY=
ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=scalper-bot <onboarding@resend.dev>

# --- Anything else: iOS Shortcuts, Home Assistant, IFTTT
ALERT_WEBHOOK_URL=

# --- Misc
# LOG_LEVEL=info
# DESKTOP_NOTIFICATIONS=false
# WATCHLIST=config/watchlist.json
